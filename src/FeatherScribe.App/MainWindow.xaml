<Window x:Class="FeatherScribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FeatherScribe" Height="500" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid Margin="{StaticResource Inset12}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StatusText" Text="待機中" Style="{StaticResource StatusTextStyle}"/>

        <TextBlock Grid.Row="1" x:Name="HotkeyHelpText" Margin="0,8,0,8"
                   TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"/>

        <GroupBox Grid.Row="2" Header="直近の結果" Style="{StaticResource CardGroupBoxStyle}">
            <TextBox x:Name="LastResultText" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Style="{StaticResource ResultTextBoxStyle}"/>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="不採用の整形候補 (確認してから手動採用)" Style="{StaticResource CardGroupBoxStyle}">
            <TextBox x:Name="RejectedResultText" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Style="{StaticResource ResultTextBoxStyle}"/>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ReformatButton" Content="もう一度整形" Padding="12,4" Margin="0,0,8,0"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="ReformatButton_Click" IsEnabled="False"
                    ToolTip="直近のraw結果を使って、バックグラウンド整形をもう一度実行します。"/>
            <Button x:Name="AdoptRejectedButton" Content="候補を手動採用" Padding="12,4" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="AdoptRejectedButton_Click" IsEnabled="False"
                    ToolTip="不採用候補を確認したうえで、直近結果として採用します。"/>
            <Button x:Name="RecopyButton" Content="クリップボードにコピー" Padding="12,4" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="RecopyButton_Click" IsEnabled="False"
                    ToolTip="直近の結果をクリップボードに入れます。貼り付けは行いません。"/>
            <Button x:Name="RepasteButton" Content="直前の入力先へ貼り付け" Padding="12,4"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="RepasteButton_Click" IsEnabled="False"
                    ToolTip="直近の結果をクリップボードに入れてから、FeatherScribeの前に使っていたウィンドウへ Ctrl+V を送信します。"/>
        </StackPanel>
    </Grid>
</Window>
