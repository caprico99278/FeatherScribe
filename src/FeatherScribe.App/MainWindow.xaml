<Window x:Class="FeatherScribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FeatherScribe" Width="800"
        SizeToContent="Height"
        Icon="Assets/Icons/FeatherScribe.ico"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <!-- The only two implicit styles (visual_direction.md §25), both window-scoped; theme dictionaries stay keyed-only.
             ScrollBar: dark scrollbars for MainContentScrollViewer and the result text boxes.
             ToolTip: dark tooltips for the action buttons instead of the light Windows default. -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DarkScrollBarStyle}"/>
        <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource AppToolTipStyle}"/>
    </Window.Resources>
    <Grid x:Name="MainWindowRoot">
    <ScrollViewer x:Name="MainContentScrollViewer"
                  AutomationProperties.AutomationId="MainContentScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="MainContentRoot"
          Margin="{StaticResource Inset24}"
          Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="{StaticResource MotionRevealOffset}"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="3"
                    Margin="0,3,12,3"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="{StaticResource PillCornerRadius}"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="FeatherScribe" Style="{StaticResource AppTitleTextStyle}"/>
                <TextBlock Text="ローカル音声入力" Style="{StaticResource CaptionTextStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource MainStatusBarStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SubtleBadgeStyle}" Margin="0,0,12,0">
                    <TextBlock Text="状態" Style="{StaticResource BadgeTextStyle}"/>
                </Border>
                <TextBlock Grid.Column="1"
                           x:Name="StatusText"
                           Text="待機中"
                           Style="{StaticResource StatusTextStyle}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ResultCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="直近の結果" Style="{StaticResource PageTitleTextStyle}"/>
                    <Border Grid.Column="1" Style="{StaticResource SubtleBadgeStyle}">
                        <TextBlock Text="コピー・貼り付け対象" Style="{StaticResource BadgeTextStyle}"/>
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBox x:Name="LastResultText"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             MinHeight="120"
                             MaxHeight="240"
                             Style="{StaticResource ResultTextBoxStyle}"/>
                    <TextBlock Text="ホットキーを押して録音を開始します。"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EmptyStateTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LastResultText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <Expander Grid.Row="3"
                  x:Name="CandidateExpander"
                  AutomationProperties.AutomationId="CandidateExpander"
                  IsExpanded="False"
                  Style="{StaticResource SectionExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="整形候補・警告" Style="{StaticResource ExpanderHeaderTextStyle}"/>
            </Expander.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,8"
                           Text="自動では採用しなかった整形候補です。確認して、必要な場合だけ採用できます。"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBox x:Name="RejectedResultText"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 MinHeight="56"
                                 MaxHeight="160"
                                 Style="{StaticResource ResultTextBoxStyle}"/>
                        <TextBlock Text="候補がある場合にここへ表示されます。"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource EmptyStateTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=RejectedResultText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Row="1"
                            x:Name="AdoptRejectedButton"
                            Content="整形候補を採用"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="AdoptRejectedButton_Click"
                            IsEnabled="False"
                            ToolTip="確認した整形候補を、直近の結果として採用します。"/>
                </Grid>
            </Grid>
        </Expander>

        <Grid Grid.Row="4" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    x:Name="ReformatButton"
                    Content="再整形"
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="ReformatButton_Click"
                    IsEnabled="False"
                    ToolTip="直近の未整形の文章を、バックグラウンドで整形し直します。"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RecopyButton"
                        Content="クリップボードにコピー"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RecopyButton_Click"
                        IsEnabled="False"
                        ToolTip="直近の結果をクリップボードに入れます。貼り付けはしません。"/>
                <Button x:Name="RepasteButton"
                        Content="直前の入力先へ貼り付け"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RepasteButton_Click"
                        IsEnabled="False"
                        ToolTip="直近の結果をクリップボードに入れてから、直前の入力先へ貼り付けます。"/>
            </WrapPanel>
        </Grid>

        <Expander Grid.Row="5"
                  x:Name="OperationGuideExpander"
                  AutomationProperties.AutomationId="OperationGuideExpander"
                  IsExpanded="False"
                  Style="{StaticResource SectionExpanderStyle}">
            <Expander.Header>
                <TextBlock Text="操作ガイド" Style="{StaticResource ExpanderHeaderTextStyle}"/>
            </Expander.Header>
            <TextBlock x:Name="HotkeyHelpText"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextStyle}"/>
        </Expander>
    </Grid>
    </ScrollViewer>

    <!-- In-App Feedback: overlaid in the same cell, so it never pushes or resizes the content. -->
    <Border x:Name="FeedbackHost"
            AutomationProperties.AutomationId="FeedbackHost"
            AutomationProperties.LiveSetting="Polite"
            Panel.ZIndex="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            MaxWidth="480"
            IsHitTestVisible="False"
            Focusable="False"
            Visibility="Collapsed"
            Opacity="0"
            Style="{StaticResource FeedbackSnackbarStyle}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="FeedbackTranslate" Y="{StaticResource MotionRevealOffset}"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"
                  Width="20"
                  Height="20"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center">
                <Ellipse x:Name="FeedbackGlyphBackground"
                         Fill="{StaticResource SuccessBrush}"/>
                <TextBlock x:Name="FeedbackGlyph"
                           Text="✓"
                           Style="{StaticResource FeedbackGlyphTextStyle}"/>
            </Grid>
            <TextBlock Grid.Column="1"
                       x:Name="FeedbackText"
                       AutomationProperties.AutomationId="FeedbackText"
                       AutomationProperties.LiveSetting="Polite"
                       Style="{StaticResource FeedbackTextStyle}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="40"/>
        </Grid>
    </Border>
    </Grid>
</Window>
