<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#101418</Color>
    <Color x:Key="SurfaceColor">#171D23</Color>
    <Color x:Key="SurfaceElevatedColor">#1E262D</Color>
    <Color x:Key="SurfaceHoverColor">#26313A</Color>
    <Color x:Key="BorderColor">#2A343D</Color>
    <Color x:Key="BorderStrongColor">#3A4853</Color>
    <Color x:Key="PrimaryTextColor">#E8EEF2</Color>
    <Color x:Key="SecondaryTextColor">#AEBBC5</Color>
    <Color x:Key="MutedTextColor">#74828D</Color>
    <Color x:Key="AccentColor">#7FD8D2</Color>
    <Color x:Key="AccentHoverColor">#95E4DE</Color>
    <Color x:Key="AccentPressedColor">#5DBCB7</Color>
    <Color x:Key="RecordingColor">#E06A6A</Color>
    <Color x:Key="SuccessColor">#7ACB8A</Color>
    <Color x:Key="WarningColor">#E2B76B</Color>
    <Color x:Key="DangerColor">#E07A7A</Color>
    <Color x:Key="OverlayBackgroundColor">#D91A222A</Color>
    <Color x:Key="SelectionColor">#28484C</Color>
    <Color x:Key="FocusColor">#9CEBE6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="RecordingBrush" Color="{StaticResource RecordingColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{StaticResource OverlayBackgroundColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
</ResourceDictionary>
