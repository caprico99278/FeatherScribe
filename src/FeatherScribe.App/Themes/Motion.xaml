<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:animation="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore">
    <Duration x:Key="MotionFastDuration">0:0:0.100</Duration>
    <Duration x:Key="MotionNormalDuration">0:0:0.180</Duration>
    <Duration x:Key="MotionSlowDuration">0:0:0.260</Duration>

    <animation:QuadraticEase x:Key="MotionEaseOut" EasingMode="EaseOut" />
    <animation:CubicEase x:Key="MotionEaseInOut" EasingMode="EaseInOut" />
</ResourceDictionary>
