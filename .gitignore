# Build outputs
bin/
obj/
*.user
*.ilk
*.pdb
*.idb

# Local runtime stack (binaries & models, multi-GB)
local/

# Model files (never commit third-party models)
models/
*.gguf
*.bin
*.onnx

# Generated audio & artifacts
*.wav
debug_artifacts/
logs/

# Sample generated artifacts: 原則コミットしない (実データ混入防止)。
# 検証済みサンプルのみ明示的に許可する。
samples/audio/*
samples/raw/*
samples/formatted/*
!samples/audio/.gitkeep
!samples/raw/.gitkeep
!samples/formatted/.gitkeep
!samples/raw/sample_001_raw.txt
!samples/formatted/sample_001_formatted.txt

