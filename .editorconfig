root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8
end_of_line = lf

[*.cs]
charset = utf-8
end_of_line = lf

[*.csproj]
charset = utf-8
end_of_line = lf

[*.slnx]
charset = utf-8
end_of_line = lf

[*.json]
charset = utf-8
end_of_line = lf
