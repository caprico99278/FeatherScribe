root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Keep .ps1 files ASCII-only: Windows PowerShell 5.1 reads BOM-less files as the ANSI code page.
[*.ps1]
charset = utf-8
end_of_line = lf

# Batch files: ASCII-only content, CRLF (cmd.exe misparses LF-only batch files).
[*.{cmd,bat}]
charset = utf-8
end_of_line = crlf

[*.cs]
charset = utf-8
end_of_line = lf

[*.csproj]
charset = utf-8
end_of_line = lf

[*.slnx]
charset = utf-8
end_of_line = lf

[*.json]
charset = utf-8
end_of_line = lf
